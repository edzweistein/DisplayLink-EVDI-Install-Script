Header {
    height: 3;
    align: center middle;
    dock: top;
}
IntroContainer {
    width: 1fr;
    height: 1fr;
    border: solid white;
}
Footer {
    height: 3;
    align: left middle;
    dock: bottom;
}

/*
InstallModal
*/
InstallModal {
    align: center middle;
}
#installDialog {
    align: center middle;
    width: 80;
    height: 30;
    background: $surface;
    border: tall $primary;
    padding: 1 2;
}

#horizontalInstBtn {
    layout: grid;
    grid-size: 2;
    height: auto;
    margin-top: 2;
    align: center middle;
    border: solid #d8dee9;
}

.installQbtn {
    color: #2e3440;
    background: #8fbcbb;
    text-style: none;
}

.installQbtn:focus {
    background: #d8dee9;
    text-style: bold underline;
}